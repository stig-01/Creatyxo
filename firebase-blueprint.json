{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Portable private player save containing profile, lifetime progression stats, achievements, daily streak history, cosmetics, and per-mode high scores",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profile": {
          "type": "object",
          "description": "Display profile metadata (no PII)"
        },
        "stats": {
          "type": "object",
          "description": "Player progression stats, achievements, daily challenges, and 30-day streak history"
        },
        "modeBestScores": {
          "type": "object",
          "description": "High scores keyed by difficulty mode (easy, classic, hard, extreme)"
        },
        "bestScore": {
          "type": "number",
          "description": "Verified all-time highest score across modes"
        },
        "activeThemeId": {
          "type": "string",
          "description": "Currently equipped visual board theme ID",
          "maxLength": 32
        },
        "activeBlockSkinId": {
          "type": "string",
          "description": "Currently equipped cosmetic block skin ID",
          "maxLength": 32
        },
        "preferencesUpdatedAt": {
          "type": "number",
          "description": "Client epoch ms when profile or cosmetic selection was last intentionally changed"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when cloud save was updated"
        }
      },
      "required": [
        "uid",
        "profile",
        "stats",
        "modeBestScores",
        "bestScore",
        "activeThemeId",
        "activeBlockSkinId",
        "preferencesUpdatedAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "A player score and public profile statistics entry on the global shared leaderboard",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Authenticated Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Display name of the player",
          "minLength": 1,
          "maxLength": 30
        },
        "tag": {
          "type": "string",
          "description": "Optional numeric tag",
          "maxLength": 10
        },
        "score": {
          "type": "number",
          "description": "Verified best score achieved"
        },
        "avatarLetter": {
          "type": "string",
          "description": "Single uppercase letter monogram",
          "minLength": 1,
          "maxLength": 2
        },
        "avatarUrl": {
          "type": "string",
          "description": "Optional compressed data URL for custom profile picture",
          "maxLength": 24000
        },
        "tier": {
          "type": "string",
          "description": "Rank tier mathematically derived from score",
          "enum": ["Grandmaster", "Master", "Diamond", "Platinum", "Gold", "Silver", "Bronze"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was saved"
        },
        "xp": {
          "type": "number",
          "description": "Total experience points earned"
        },
        "level": {
          "type": "number",
          "description": "Player level mathematically derived from XP"
        },
        "totalPlaytimeSec": {
          "type": "number",
          "description": "Total active gameplay duration in seconds"
        },
        "longestSessionSec": {
          "type": "number",
          "description": "Longest single game session duration in seconds"
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Total completed or played games"
        },
        "totalLinesCleared": {
          "type": "number",
          "description": "Cumulative rows and columns cleared"
        },
        "bestCombo": {
          "type": "number",
          "description": "Highest consecutive combo multiplier achieved"
        },
        "dailyStreak": {
          "type": "number",
          "description": "Current daily streak count in days"
        },
        "achievementsCount": {
          "type": "number",
          "description": "Number of unlocked achievements"
        },
        "activeTheme": {
          "type": "string",
          "description": "Currently equipped visual theme ID",
          "maxLength": 32
        },
        "modeBestScores": {
          "type": "object",
          "description": "Verified best scores keyed by grid mode (easy 10x10, classic 8x8, hard 6x6, extreme 4x4)"
        }
      },
      "required": [
        "id",
        "username",
        "score",
        "avatarLetter",
        "tier",
        "updatedAt",
        "xp",
        "level",
        "totalPlaytimeSec",
        "longestSessionSec",
        "gamesPlayed",
        "totalLinesCleared",
        "bestCombo",
        "dailyStreak",
        "achievementsCount"
      ]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Friend request or accepted friendship between two authenticated player UIDs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic sorted pair ID (uidA__uidB)",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "users": {
          "type": "array",
          "description": "Sorted pair of the two participant UIDs"
        },
        "fromId": {
          "type": "string",
          "description": "UID of the player who initiated the friend request",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toId": {
          "type": "string",
          "description": "UID of the player who receives the friend request",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUsername": {
          "type": "string",
          "description": "Display username of sender",
          "minLength": 1,
          "maxLength": 30
        },
        "toUsername": {
          "type": "string",
          "description": "Display username of recipient",
          "minLength": 1,
          "maxLength": 30
        },
        "status": {
          "type": "string",
          "description": "Current friend request status",
          "enum": ["pending", "accepted", "declined"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when request was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when status last changed"
        }
      },
      "required": ["id", "users", "fromId", "toId", "fromUsername", "toUsername", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Owner-only portable player account save keyed by Firebase Auth UID"
    },
    "/leaderboard/{playerId}": {
      "schema": "LeaderboardEntry",
      "description": "Global shared leaderboard and public player profile statistics keyed by Firebase Auth UID"
    },
    "/friendships/{friendshipId}": {
      "schema": "Friendship",
      "description": "Mutual friend requests and accepted friendships scoped strictly to participants"
    }
  }
}
